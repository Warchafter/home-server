# =============================================================================
# Home Server Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: .env is gitignored and will NOT be committed to the repository.
# This .env.example file IS committed as a template/reference.
# =============================================================================

# ---------------------------------------------------------------------------
# Server Configuration
# ---------------------------------------------------------------------------

# Your server's local IP address on your home network.
# Find it with: ip addr show | grep "inet " | grep -v 127.0.0.1
# IMPORTANT: Set a static IP (DHCP reservation) on your router for this server.
SERVER_IP=192.168.1.100

# DNS server the outbound-calling containers use (sonarr, radarr, prowlarr,
# bazarr, jellyfin, syncthing, flaresolverr). They pin this instead of
# inheriting the host's resolv.conf — Tailscale MagicDNS has ended up in there
# before and every container lookup returned SERVFAIL. Use your router or
# AdGuard (SERVER_IP). 1.1.1.1 is always the fallback.
# Prefer SERVER_IP: lookups then use AdGuard's encrypted upstreams instead of
# leaving in plaintext (docs/security-hardening.md §5).
CONTAINER_DNS=192.168.1.100

# Timezone for all containers (affects log timestamps, scheduled tasks).
# Find yours: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Chicago

# ---------------------------------------------------------------------------
# User/Group IDs
# ---------------------------------------------------------------------------
# Docker containers run as a user inside the container. These IDs map
# container file ownership to your host user, preventing permission issues.
# Find your values with: id $USER
# If these are wrong, containers may create files owned by root or fail to
# read configs. Defaults (1000/1000) are correct for most single-user installs.
PUID=1000
PGID=1000

# ---------------------------------------------------------------------------
# Homepage Dashboard
# ---------------------------------------------------------------------------
# Server's Tailscale IP (tailscale ip -4). Used for Homepage's host allowlist.
# TAILSCALE_IP=100.x.y.z
#
# Exact Host values the dashboard answers to — comma-separated, no spaces,
# no CIDR. Default: SERVER_IP and TAILSCALE_IP. Add the MagicDNS name if you
# browse by name. Do not use * (disables the DNS-rebinding protection).
# HOMEPAGE_ALLOWED_HOSTS=192.168.0.117,100.82.82.78,home.tailXXXX.ts.net
#
# Optional login for the dashboard and its /api routes (Homepage v2):
#   HOMEPAGE_AUTH_SECRET: openssl rand -base64 32
#   HOMEPAGE_EXTERNAL_URL: one URL used for login redirects — the MagicDNS
#   name works both at home and away (http:// is fine on the tailnet)
# HOMEPAGE_AUTH_ENABLED=true
# HOMEPAGE_AUTH_SECRET=
# HOMEPAGE_AUTH_PASSWORD=
# HOMEPAGE_EXTERNAL_URL=http://home.tailXXXX.ts.net

# ---------------------------------------------------------------------------
# AdGuard Home (set after completing the setup wizard at http://SERVER_IP:3000)
# ---------------------------------------------------------------------------
# These are used by the Homepage dashboard widget to display AdGuard stats.
# ADGUARD_USER=your-adguard-username
# ADGUARD_PASS=your-adguard-password

# ---------------------------------------------------------------------------
# Media Storage (Phase 2)
# ---------------------------------------------------------------------------
# Root directory for all media files (movies, TV, downloads).
# All media containers mount this path. Use an absolute path.
# Default /srv/media works for the internal drive. Change to /mnt/storage/media
# (or similar) if you add an external drive later.
MEDIA_PATH=/srv/media

# ---------------------------------------------------------------------------
# Syncthing Data (Phase 2)
# ---------------------------------------------------------------------------
# Directory for Syncthing's synchronized files.
SYNCTHING_DATA_PATH=/srv/syncthing

# ---------------------------------------------------------------------------
# Vaultwarden (Phase 2)
# ---------------------------------------------------------------------------
# Allow new user registrations. Set to 'true' TEMPORARILY for first-time setup,
# then set back to 'false' and run: docker compose up -d vaultwarden
VAULTWARDEN_SIGNUPS_ALLOWED=false
# Password for the daily backup zips (stacks/vaultwarden-backup.yaml) — required.
# Without it the image uses a public default. Store it in Vaultwarden + on paper.
# Generate with: openssl rand -base64 24
VAULTWARDEN_BACKUP_ZIP_PASSWORD=

# ---------------------------------------------------------------------------
# Jellyfin (set after first launch — Phase 2)
# ---------------------------------------------------------------------------
# API key for Homepage widget. Generate in Jellyfin > Dashboard > API Keys.
# JELLYFIN_API_KEY=your-jellyfin-api-key

# ---------------------------------------------------------------------------
# Sonarr (set after first launch — Phase 2)
# ---------------------------------------------------------------------------
# API key for Homepage widget. Find in Sonarr > Settings > General > API Key.
# SONARR_API_KEY=your-sonarr-api-key

# ---------------------------------------------------------------------------
# Radarr (set after first launch — Phase 2)
# ---------------------------------------------------------------------------
# API key for Homepage widget. Find in Radarr > Settings > General > API Key.
# RADARR_API_KEY=your-radarr-api-key

# ---------------------------------------------------------------------------
# Prowlarr (set after first launch — Phase 2)
# ---------------------------------------------------------------------------
# API key for Homepage widget. Find in Prowlarr > Settings > General > API Key.
# PROWLARR_API_KEY=your-prowlarr-api-key

# ---------------------------------------------------------------------------
# Bazarr (set after first launch — Phase 2)
# ---------------------------------------------------------------------------
# API key for Homepage widget. Find in Bazarr > Settings > General > API Key.
# BAZARR_API_KEY=your-bazarr-api-key

# ---------------------------------------------------------------------------
# ProtonVPN / Gluetun (Phase 2)
# ---------------------------------------------------------------------------
# VPN tunnel for qBittorrent using WireGuard (faster than OpenVPN).
# Get your WireGuard private key from:
#   1. https://account.proton.me → VPN → WireGuard
#   2. Select Linux, enable port forwarding (requires Plus plan)
#   3. Download the .conf file
#   4. Copy the PrivateKey value (base64 string after "PrivateKey = ")
# PROTONVPN_WIREGUARD_KEY=your-wireguard-private-key
# Country for VPN server selection (default: Netherlands, good for P2P)
# PROTONVPN_COUNTRY=Netherlands

# ---------------------------------------------------------------------------
# qBittorrent (set after first launch — Phase 2)
# ---------------------------------------------------------------------------
# Web UI credentials for Homepage widget.
# Default username is 'admin'. Password is random on first launch —
# check: docker compose logs qbittorrent | grep password
# QBITTORRENT_USER=admin
# QBITTORRENT_PASS=your-qbittorrent-password

# ---------------------------------------------------------------------------
# Home Assistant (set after first launch — Phase 2)
# ---------------------------------------------------------------------------
# Long-lived access token for Homepage widget.
# Generate in HA > Profile > Long-Lived Access Tokens > Create Token.
# HOMEASSISTANT_API_KEY=your-ha-long-lived-token

# ---------------------------------------------------------------------------
# Grafana (Phase 3)
# ---------------------------------------------------------------------------
# Admin password for the Grafana web UI. REQUIRED — generate a strong password.
# Grafana will refuse to start without this set (no default fallback).
GRAFANA_ADMIN_PASS=<generate-a-strong-password>

# ---------------------------------------------------------------------------
# Kavita (set after first launch — Phase 3)
# ---------------------------------------------------------------------------
# Credentials for the Homepage widget. Set after creating your Kavita account.
# KAVITA_USER=your-kavita-username
# KAVITA_PASS=your-kavita-password

# ---------------------------------------------------------------------------
# MCP server (stacks/mcp.yaml)
# ---------------------------------------------------------------------------
# Reuses the API keys above (SONARR/RADARR/PROWLARR/BAZARR/JELLYFIN_API_KEY and
# QBITTORRENT_USER/PASS) for its arr_status / qbittorrent_status /
# jellyfin_status tools. A blank key disables that tool.
# Bearer token required on /mcp — compose refuses to start without it.
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Alerting (scripts/alert-check.py — host cron; see docs/deployment.md)
# ---------------------------------------------------------------------------
# Outbound-only channels, so they work with no public domain. Set one or both.
# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy URL
# ALERT_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# Telegram: create a bot with @BotFather, send it one message, then read your
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
# ALERT_TELEGRAM_BOT_TOKEN=123456789:ABC...
# ALERT_TELEGRAM_CHAT_ID=123456789
# Alert when the root filesystem is this full, in percent, measured as the
# space non-root processes can still use (what the containers see). Default 85.
# ALERT_DISK_THRESHOLD=85

# ---------------------------------------------------------------------------
# Diun — image update notifications (stacks/diun.yaml)
# ---------------------------------------------------------------------------
# Leave a channel commented out to keep it disabled. Same values as the
# ALERT_* ones above are fine.
# DIUN_NOTIF_DISCORD_WEBHOOKURL=https://discord.com/api/webhooks/...
# DIUN_NOTIF_TELEGRAM_TOKEN=123456789:ABC...
# DIUN_NOTIF_TELEGRAM_CHATIDS=123456789

# ---------------------------------------------------------------------------
# Backrest — offsite backups to Backblaze B2 (stacks/backrest.yaml, docs/backups.md)
# ---------------------------------------------------------------------------
# Server key: ONE bucket, capabilities listBuckets,listFiles,readFiles,writeFiles
# (no deleteFiles — created with the b2 CLI, see docs/backups.md §1).
# The restic repository password is set in the Backrest UI, not here —
# store it in Vaultwarden AND on paper.
# BACKREST_B2_KEY_ID=
# BACKREST_B2_APP_KEY=

# ---------------------------------------------------------------------------
# Vaultwarden public URL (after Tailscale Serve, docs/security-hardening.md §4)
# ---------------------------------------------------------------------------
# VAULTWARDEN_DOMAIN=https://home.tailXXXX.ts.net

# ---------------------------------------------------------------------------
# Domain Configuration (leave commented out until you buy a domain)
# ---------------------------------------------------------------------------
# See docs/adding-a-domain.md for the full upgrade guide.
# DOMAIN=yourdomain.com
# ACME_EMAIL=your@email.com
